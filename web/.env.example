# Copia este archivo como .env.local y completa los valores. NUNCA subas .env.local al repositorio.
# En Vercel, carga las mismas variables en Settings → Environment Variables (Production y Preview).

# --- Supabase (Project Settings → API) ---
# Públicas: se usan también en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
# La "anon" (legacy) o la "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA, solo servidor: la "service_role" (legacy) o una "secret" key. Se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (Turnstile → tu widget) ---
# Para desarrollo local puedes usar las claves de prueba de Cloudflare:
#   site key:   1x00000000000000000000AA   (siempre pasa)
#   secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secretos propios (solo servidor) ---
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" al llamar al cron de limpieza.
CRON_SECRET=cadeba501adbbbfb412856fd118d62054f71f6087a81ec7a7ce9ecf2868ab153
# Firma el ticket entre los dos pasos del envío y sirve de sal para el hash de la IP.
POSTULACION_SECRET=
